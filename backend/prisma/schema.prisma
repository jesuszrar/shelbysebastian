generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  cedula        String         @unique
  isAdmin       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  addresses     UserAddress[]
  refreshTokens RefreshToken[]
  wompiAttemptResolutions WompiPaymentAttemptResolution[]
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model Product {
  id                      String   @id
  name                    String
  category                String
  price                   Decimal  @db.Decimal(12, 2)
  stock                   Int      @default(0)
  image                   String?
  description             String?  @db.Text
  specs                   Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  badge                   String?
  highlight               Boolean  @default(false)
  oldPrice                Decimal? @db.Decimal(12, 2)
  activateWholesale       Boolean  @default(false)
  wholesaleMinQty         Int      @default(0)
  wholesaleDiscountPercent Int      @default(0)
  variants                ProductVariant[]
  categories              ProductCategory[]
  images                  ProductImage[]
}

model Category {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  products  ProductCategory[]
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductExclusion {
  productId String   @id
  deletedAt DateTime @default(now())
}

model ProductVariantExclusion {
  variantId String   @id
  productId String
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id          String   @id
  productId   String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  image       String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  images      ProductImage[]

  @@index([productId])
  @@index([active])
}

model ProductImage {
  id          String          @id @default(cuid())
  productId   String
  variantId   String?
  url         String
  sortOrder   Int             @default(0)
  isPrimary   Boolean         @default(false)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model Order {
  id                  String    @id
  items               Json
  total               Decimal   @db.Decimal(12, 2)
  status              String    @default("pending")
  userId              String?
  createdAt           DateTime  @default(now())
  customerAddress     String?
  customerCity        String?
  customerEmail       String?
  customerName        String?
  customerPhone       String?
  invoiceSentAt       DateTime?
  notes               String?   @db.Text
  paymentMethod       String?
  shipping            Int       @default(0)
  discountAmount      Decimal?  @db.Decimal(12, 2)
  couponCode          String?
  wompiTransactionId  String?   @unique
  paymentStatus       String?
  shipping_address    String?
  shipping_city       String?
  shipping_department String?
  shipping_email      String?
  shipping_name       String?
  shipping_phone      String?
  shipping_reference  String?
  user                User?     @relation(fields: [userId], references: [id])
  paymentAttempts     WompiPaymentAttempt[]
  wompiTransactions   WompiTransaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([couponCode])
}

model WompiPaymentAttempt {
  id              String            @id @default(cuid())
  orderId         String
  reference       String            @unique
  amountInCents   BigInt
  currency        String            @default("COP")
  snapshot        Json
  status          String            @default("PREPARED")
  paymentLinkId   String?           @unique
  paymentUrl      String?
  expiresAt       DateTime?
  requestStartedAt DateTime?
  resolutionNote  String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions    WompiTransaction[]
  resolutions     WompiPaymentAttemptResolution[]

  @@index([orderId, createdAt])
  @@index([status, updatedAt])
}

model WompiPaymentAttemptResolution {
  id                 String              @id @default(cuid())
  attemptId          String
  performedByUserId  String?
  previousStatus     String
  nextStatus         String
  evidenceReference  String
  note               String              @db.Text
  createdAt          DateTime             @default(now())
  attempt            WompiPaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  performedBy        User?                @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([attemptId, createdAt])
  @@index([performedByUserId, createdAt])
}

model WompiTransaction {
  id                    String               @id @default(cuid())
  providerTransactionId String               @unique
  attemptId             String?
  orderId               String?
  reference             String
  amountInCents         BigInt?
  currency              String?
  status                String
  reviewReason          String?              @db.Text
  payload               Json
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  attempt               WompiPaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  order                 Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([attemptId, createdAt])
  @@index([reference])
}

model WompiWebhookReceipt {
  id           String           @id @default(cuid())
  bodyHash     String           @unique
  payload      Json
  receivedAt   DateTime         @default(now())
  reviewReason String?          @db.Text
  job          WompiWebhookJob?
}

model WompiWebhookJob {
  id            String             @id @default(cuid())
  receiptId     String             @unique
  status        String             @default("PENDING")
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lockedAt      DateTime?
  lastError     String?            @db.Text
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  receipt       WompiWebhookReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
}

model Coupon {
  code            String    @id
  type            String
  value           Decimal   @db.Decimal(12, 2)
  active          Boolean   @default(true)
  minimumSubtotal Decimal?  @db.Decimal(12, 2)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CouponAudit {
  id                String   @id @default(cuid())
  couponCode        String
  action            String
  performedByUserId String?
  performedByEmail  String?
  details           Json?
  createdAt         DateTime @default(now())

  @@index([couponCode])
}

model CedulaEmail {
  cedula    String   @id
  email     String   @unique
  userId    String?  @unique
  createdAt DateTime @default(now())
}

model UserAddress {
  id         String   @id @default(cuid())
  userId     String
  label      String
  fullName   String
  cedula     String
  email      String
  phone      String
  department String
  city       String
  address    String
  reference  String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NiimbotPageImage {
  id        String   @id @default(cuid())
  key       String   @unique
  path      String
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
