{
  "name": "shelby-mysql-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm exec -- prisma generate && npm exec -- tsc -p tsconfig.json",
    "start": "npm exec -- prisma migrate deploy && node dist/server.js",
    "start:prod": "npm exec -- prisma migrate deploy && node dist/server.js",
    "prisma:generate": "npm exec -- prisma generate",
    "prisma:migrate": "npm exec -- prisma migrate deploy",
    "prisma:studio": "npm exec -- prisma studio"
  },
  "packageManager": "npm@10.13.0",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^9.0.3",
    "prisma": "6.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
