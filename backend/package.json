{
  "name": "shelby-importaciones-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm exec -- prisma generate && npm exec -- tsc -p tsconfig.json",
    "test:catalog-exclusions": "tsx --test src/lib/productCatalogLock.test.ts src/lib/product-exclusions.test.ts src/lib/product-variant-persistence.test.ts src/scripts/sync-product-catalog.test.ts",
    "test:security": "tsx --test src/server.security.test.ts",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "prisma:generate": "npm exec -- prisma generate",
    "prisma:migrate": "npm exec -- prisma migrate deploy",
    "prisma:studio": "npm exec -- prisma studio"
  },
  "packageManager": "npm@10.13.0",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "prisma": "6.15.0",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.20.3"
  }
}
